# Python cache and testing artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
pytest-cache-files-*/

# Terraform local configurations, state, and logs
.terraform/
*.tfstate
*.tfstate.backup
terraform/tfplan
terraform/provider_schema.json
terraform/plan_log.txt

# Frontend build outputs and dependencies
frontend/dist/
frontend/node_modules/
frontend/.env.local
frontend/.env.production.local
frontend/.env.development.local

# Backend zip packages (generated by terraform locally on build)
backend/*.zip

# OS files
.DS_Store
Thumbs.db

# Documentation (kept locally)
QUICK_START.md
SYSTEM_GUIDE.md
DEPLOYMENT_SUMMARY.md
